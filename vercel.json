{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/v2", "destination": "/dashboard", "permanent": false },
    { "source": "/v2/dashboard", "destination": "/dashboard", "permanent": false },
    { "source": "/v2/home", "destination": "/dashboard", "permanent": false },
    { "source": "/v2/notes", "destination": "/notes", "permanent": false },
    { "source": "/v2/library", "destination": "/library", "permanent": false },
    { "source": "/v2/bookmarks", "destination": "/bookmarks", "permanent": false },
    { "source": "/v2/search", "destination": "/search", "permanent": false },
    { "source": "/v2/profile", "destination": "/profile", "permanent": false },
    { "source": "/v2/document", "destination": "/document", "permanent": false },
    { "source": "/case-law", "destination": "/library", "permanent": false },
    { "source": "/statutes", "destination": "/library", "permanent": false }
  ],
  "rewrites": [
    { "source": "/home", "destination": "/index.html" },
    { "source": "/about", "destination": "/sikia-about.html" },
    { "source": "/features", "destination": "/sikia-features.html" },
    { "source": "/contact", "destination": "/sikia-contact.html" },
    { "source": "/login", "destination": "/sikia-login.html" },
    { "source": "/signup", "destination": "/sikia-signup.html" },
    { "source": "/register", "destination": "/sikia-signup.html" },

    { "source": "/dashboard", "destination": "/sikia-dashboard.html" },
    { "source": "/notes", "destination": "/sikia-notes.html" },
    { "source": "/library", "destination": "/sikia-library.html" },
    { "source": "/document", "destination": "/sikia-document.html" },
    { "source": "/bookmarks", "destination": "/sikia-bookmarks.html" },
    { "source": "/search", "destination": "/sikia-search.html" },
    { "source": "/profile", "destination": "/sikia-profile.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/Notes/(.*)\\.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" }
      ]
    },
    {
      "source": "/fonts/(.*)\\.otf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/notes-content/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
